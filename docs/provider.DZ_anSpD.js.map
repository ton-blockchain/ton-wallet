{
  "name": "mytonwallet",
  "version": "26.9.9",
  "description": "The most feature-rich web wallet and browser extension for TON – with support of multi-accounts, tokens (jettons), NFT, TON DNS, TON Sites, TON Proxy, and TON Magic.",
  "main": "index.js",
  "scripts": {
    "dev": "cross-env APP_ENV=development vite",
    "build": "vite build && bash ./deploy/copy_to_dist.sh",
    "build:dev": "APP_ENV=development vite build --mode development && bash ./deploy/copy_to_dist.sh",
    "build:staging": "cross-env APP_ENV=staging npm run build",
    "build:production": "npm run build",
    "gram:dev": "cross-env IS_GRAM_WALLET=1 npm run dev",
    "gram:build": "cross-env IS_GRAM_WALLET=1 npm run build",
    "gram:build:dev": "cross-env IS_GRAM_WALLET=1 npm run build:dev",
    "gram:build:staging": "cross-env IS_GRAM_WALLET=1 npm run build:staging",
    "gram:build:production": "cross-env IS_GRAM_WALLET=1 npm run build:production",
    "gram:extension:dev": "cross-env IS_GRAM_WALLET=1 npm run extension:dev",
    "gram:extension-chrome:package": "cross-env IS_GRAM_WALLET=1 npm run extension-chrome:package",
    "gram:extension-chrome:package:staging": "cross-env IS_GRAM_WALLET=1 npm run extension-chrome:package:staging",
    "gram:extension-chrome:package:production": "cross-env IS_GRAM_WALLET=1 npm run extension-chrome:package:production",
    "extension:dev": "cross-env IS_EXTENSION=1 npm run build:dev",
    "extension-chrome:package": "cross-env IS_EXTENSION=1 vite build && bash ./deploy/package_extension.sh chrome",
    "extension-chrome:package:staging": "APP_ENV=staging npm run extension-chrome:package",
    "extension-chrome:package:production": "npm run extension-chrome:package",
    "extension-firefox:package": "cross-env IS_FIREFOX_EXTENSION=1 IS_EXTENSION=1 vite build && bash ./deploy/package_extension.sh firefox",
    "extension-firefox:package:staging": "cross-env APP_ENV=staging npm run extension-firefox:package",
    "extension-firefox:package:production": "npm run extension-firefox:package",
    "extension-opera:package": "cross-env IS_OPERA_EXTENSION=1 IS_EXTENSION=1 vite build && bash ./deploy/package_extension.sh opera",
    "extension-opera:package:staging": "cross-env APP_ENV=staging npm run extension-opera:package",
    "extension-opera:package:production": "npm run extension-opera:package",
    "electron:dev": "ENV=development npm run electron:bundle && IS_PACKAGED_ELECTRON=1 ENV=development concurrently --ks SIGKILL -n main,renderer,electron \"npm run electron:bundle -- --watch\" \"npm run dev\" \"electronmon dist/electron\"",
    "electron:bundle": "cross-env APP_ENV=$ENV vite build --config ./vite-electron.config.ts",
    "electron:build": "IS_PACKAGED_ELECTRON=1 npm run build:$ENV && electron-builder install-app-deps && ENV=$ENV npm run electron:bundle",
    "electron:package": "npm run electron:build && rm -rf dist-electron && electron-builder build --win --mac --linux --config src/electron/config.yml",
    "electron:package:staging": "ENV=staging npm run electron:package -- -p never",
    "electron:release:production": "ENV=production npm run electron:package -- -p always",
    "telegram:dev": "cross-env IS_TELEGRAM_APP=1 npm run dev",
    "telegram:build": "IS_TELEGRAM_APP=1 npm run build",
    "telegram:build:dev": "cross-env APP_ENV=development npm run telegram:build",
    "telegram:build:staging": "cross-env APP_ENV=staging npm run telegram:build",
    "telegram:build:production": "npm run telegram:build",
    "explorer:dev": "cross-env IS_EXPLORER=1 npm run dev",
    "explorer:build": "cross-env IS_EXPLORER=1 npm run build",
    "explorer:build:dev": "cross-env IS_EXPLORER=1 npm run build:dev",
    "explorer:build:staging": "cross-env IS_EXPLORER=1 npm run build:staging",
    "explorer:build:production": "cross-env IS_EXPLORER=1 npm run build:production",
    "mobile:build:sdk": "bash ./deploy/build_sdk.sh",
    "sdk:build:slim": "cross-env NO_EXTRA_FEATURES=1 vite build --config vite-air.config.ts",
    "mobile:build": "npm run i18n:build:android && npm run mobile:build:sdk",
    "mobile:build:dev": "cross-env APP_ENV=development npm run mobile:build",
    "mobile:build:staging": "cross-env APP_ENV=staging npm run mobile:build",
    "mobile:build:production": "npm run mobile:build",
    "build:icons": "fantasticon",
    "check": "tsc && stylelint \"**/*.{css,scss}\" && eslint .",
    "check:fix": "npm run fix:file-names && stylelint \"**/*.{css,scss}\" --fix && eslint . --fix",
    "fix:file-names": "node dev/fixFileNames.mjs",
    "test:file-names": "node --test dev/fileNamingConfigTests.mjs dev/fixFileNamesTests.mjs",
    "test:extension-licenses": "node --test dev/extensionLicensesTests.mjs",
    "test:signing-schedule": "node --test dev/signingExpiryScheduleTests.mjs",
    "test": "cross-env APP_ENV=test jest --verbose",
    "contract:agent:v2:check": "node dev/checkAgentV2Contract.mjs && tsc -p dev/agentV2/tsconfig.json && cross-env APP_ENV=test jest src/api/agentV2/protocol/transportContracts.test.ts --runInBand",
    "test:agent:v2": "cross-env APP_ENV=test jest src/api/agentV2 src/api/environment.agentV2.test.ts src/api/methods/agentV2Lifecycle.test.ts src/api/methods/registry.test.ts src/components/agentV2 src/components/agent src/config.agentV2.test.ts src/util/agent/agentProtocolVersion.test.ts src/util/renderMarkdown.test.ts",
    "build:agent:v2:e2e": "cross-env APP_ENV=development AGENT_OVERRIDE=no_override AGENT_V2_QUOTA_STATUS_ENABLED=1 AGENT_API_URL=http://127.0.0.1:1235/api vite build --mode development && bash ./deploy/copy_to_dist.sh",
    "dev:agent:v2": "bash dev/agentV2/frontendLocal.sh",
    "dev:agent:v2:ios": "bash dev/agentV2/iosLocal.sh",
    "dev:agent:v2:ios:codex": "cross-env AGENT_V2_IOS_PROVIDER=codex_subscription bash dev/agentV2/iosLocal.sh",
    "smoke:agent:v2:local": "npm run contract:agent:v2:check && bash dev/agentV2/smokeLocal.sh",
    "test:agent:v2:e2e": "playwright test --config playwright.agent-v2.config.ts",
    "test:record": "playwright codegen localhost:1235",
    "prepare": "husky",
    "postinstall": "patch-package --error-on-fail",
    "build:stats": "cross-env BUNDLE_STATS=1 vite build",
    "bundle:agent:v2:check": "node --test dev/checkAgentV2BundleBoundaryTests.mjs && node dev/checkAgentV2BundleBoundary.mjs --manifest dist/bundle-manifest.json",
    "analyze:bundle": "node dev/analyzeBundleSize.mjs",
    "postversion": "./deploy/postversion.sh",
    "multisend:build": "vite build --config vite-multisend.config.ts && bash ./deploy/copy_to_dist.sh dist-multisend src/multisend/public",
    "multisend:build:dev": "APP_ENV=development vite build --mode development --config vite-multisend.config.ts",
    "multisend:dev": "APP_ENV=development vite --config vite-multisend.config.ts",
    "portfolio:build": "vite build --config vite-portfolio.config.ts && bash ./deploy/copy_to_dist.sh dist-portfolio src/portfolio/public",
    "portfolio:build:dev": "APP_ENV=development vite build --mode development --config vite-portfolio.config.ts",
    "portfolio:dev": "APP_ENV=development vite --config vite-portfolio.config.ts",
    "push:build": "IS_TELEGRAM_APP=1 vite build --config vite-push.config.ts && bash ./deploy/copy_to_dist.sh dist-push src/push/public",
    "push:build:dev": "APP_ENV=development IS_TELEGRAM_APP=1 vite build --mode development --config vite-push.config.ts",
    "push:dev": "APP_ENV=development IS_TELEGRAM_APP=1 vite --config vite-push.config.ts",
    "resolve-stacktrace": "node ./dev/resolveStackTrace.mjs",
    "i18n:build:default": "node ./dev/locales/buildDefault.js",
    "i18n:build:android": "node ./dev/locales/buildAndroidResources.js",
    "i18n:update": "node ./dev/locales/updateLocales.js",
    "i18n:find-missing": "node ./dev/locales/findMissingKeys.js",
    "mfa:build": "IS_TELEGRAM_APP=1 vite build --config vite-mfa.config.ts && bash ./deploy/copy_to_dist.sh dist-mfa src/mfa/public",
    "mfa:build:dev": "APP_ENV=development IS_TELEGRAM_APP=1 vite build --mode development --config vite-mfa.config.ts",
    "mfa:dev": "APP_ENV=development IS_TELEGRAM_APP=1 vite --config vite-mfa.config.ts"
  },
  "engines": {
    "node": "^22.6 || ^24",
    "npm": "^10.8 || ^11"
  },
  "husky": {
    "hooks": {
      "pre-commit": "tsc && lint-staged"
    }
  },
  "lint-staged": {
    "*.module.scss": "eslint",
    "*.{ts,tsx,js}": "eslint --fix",
    "*.{css,scss}": "stylelint --fix"
  },
  "author": "MyTonWallet",
  "license": "SEE LICENSE IN LICENSE",
  "protocols": [
    {
      "name": "Ton",
      "schemes": [
        "ton"
      ]
    },
    {
      "name": "TonConnect",
      "schemes": [
        "tc",
        "mytonwallet-tc"
      ]
    },
    {
      "name": "My Wallet",
      "schemes": [
        "mtw"
      ]
    }
  ],
  "devDependencies": {
    "@babel/core": "7.27.1",
    "@babel/preset-env": "7.27.2",
    "@babel/preset-react": "7.27.1",
    "@babel/preset-typescript": "7.27.1",
    "@babel/register": "7.27.1",
    "@mytonwallet/eslint-config": "github:mytonwallet-org/eslint-config#03e3491cf5ffd909041c53fa91bebd69a36ca3a8",
    "@mytonwallet/stylelint-whole-pixel": "github:mytonwallet-org/stylelint-whole-pixel#fd07e44d786460f7d469076b1d2cb1b05297896c",
    "@playwright/test": "1.57.0",
    "@stylistic/stylelint-plugin": "3.1.2",
    "@tonconnect/protocol": "2.3.0-beta.0",
    "@twa-dev/types": "8.0.2",
    "@twbs/fantasticon": "3.1.0",
    "@types/chrome": "0.0.323",
    "@types/jest": "30.0.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.15.21",
    "@types/react": "19.1.5",
    "@types/react-dom": "19.1.5",
    "@types/sha256": "0.2.2",
    "@types/uuid": "10.0.0",
    "@types/webextension-polyfill": "0.12.3",
    "autoprefixer": "10.4.21",
    "babel-plugin-transform-import-meta": "2.3.2",
    "browserslist": "4.28.1",
    "concurrently": "9.1.2",
    "cross-env": "7.0.3",
    "dotenv": "16.5.0",
    "electron": "39.2.7",
    "electron-builder": "26.8.1",
    "electron-context-menu": "4.1.1",
    "electron-updater": "6.6.2",
    "electron-window-state": "5.0.3",
    "electronmon": "2.0.4",
    "eslint": "9.39.2",
    "fake-indexeddb": "6.2.5",
    "husky": "9.1.7",
    "jest": "30.2.0",
    "jest-environment-jsdom": "30.2.0",
    "js-yaml": "4.1.1",
    "lint-staged": "16.0.0",
    "patch-package": "8.0.1",
    "postcss": "8.5.3",
    "postcss-modules": "6.0.1",
    "process": "0.11.10",
    "replace-in-file": "8.4.0",
    "rollup-plugin-bundle-stats": "4.22.3",
    "sass": "1.89.0",
    "source-map": "0.7.4",
    "stylelint": "16.19.1",
    "stylelint-config-clean-order": "7.0.0",
    "stylelint-config-recommended-scss": "15.0.1",
    "stylelint-declaration-block-no-ignored-properties": "2.8.0",
    "stylelint-group-selectors": "1.0.10",
    "stylelint-high-performance-animation": "1.11.0",
    "stylelint-order": "7.0.0",
    "tonapi-sdk-js": "^2.0.23",
    "typescript": "5.8.3",
    "typescript-eslint": "8.56.0",
    "vite": "8.3.0"
  },
  "dependencies": {
    "@ledgerhq/hw-transport-webhid": "6.30.0",
    "@ledgerhq/hw-transport-webusb": "6.29.4",
    "@noble/curves": "1.9.7",
    "@reown/walletkit": "1.5.5",
    "@scure/bip32": "^1.5.0",
    "@scure/btc-signer": "^1.5.0",
    "@solana/kit": "5.1.0",
    "@ton-community/tlb-runtime": "1.0.0-alpha.3",
    "@ton-community/ton-ledger": "7.4.0-pre.0",
    "@ton/core": "0.60.1",
    "@ton/crypto": "3.3.0",
    "@ton/ton": "15.2.1",
    "@tonconnect/sdk": "^3.4.1",
    "@tonconnect/ui": "^2.2.0",
    "bip39": "3.1.0",
    "buffer": "6.0.3",
    "dexie": "4.0.11",
    "electron-conf": "1.3.0",
    "ethers": "^6.13.0",
    "fflate": "0.8.2",
    "idb-keyval": "6.2.2",
    "lovely-chart": "^2.0.4",
    "poseidon-bls12381": "^1.0.2",
    "qr-code-styling": "github:mytonwallet-org/qr-code-styling#671f29cc908681b5f5c7979fd418ff1fdf30ca9f",
    "qrcode-generator": "1.4.4",
    "tronweb": "6.0.0",
    "tweetnacl": "1.0.3",
    "webextension-polyfill": "0.12.0"
  },
  "overrides": {
    "bfj": "7.0.2"
  }
}
